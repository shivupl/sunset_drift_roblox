--!strict
-- The sun strip's slats (garage round 3 §3; CarStripShapes, generated by
-- tools/cosmetics/strip_shapes.py): every catalog car has them, as many as
-- CosmeticsConfig.render.stripSlats, in order from the car's left to its
-- right, each overlapping the next with no gap (at both edges: the
-- generator checks the corners), their faces looking
-- forward and up, and their canvas slices tiling the whole strip.
local CarStripShapes = require(script.Parent.Parent.CarStripShapes)
local CarCosmeticMounts = require(script.Parent.Parent.CarCosmeticMounts)
local ConfigLoader = require(script.Parent.Parent.ConfigLoader)
local CosmeticsConfig = require(script.Parent.Parent.CosmeticsConfig)
local Tests = require(script.Parent)
type T = Tests.T

local R = CosmeticsConfig.render

local function v(a: { number }): Vector3
	return Vector3.new(a[1], a[2], a[3])
end

return function(t: T)
	for id in ConfigLoader.catalog().cars do
		local shape = CarStripShapes[id]
		t.ok(shape ~= nil, `{id}: has strip shape data`)
		if not shape then
			continue
		end
		local spot = CarCosmeticMounts.cars[id] and CarCosmeticMounts.cars[id].windscreen
		t.ok(spot ~= nil, `{id}: its strip shape has a windscreen spot`)
		t.eq(#shape.slats, R.stripSlats, `{id}: stripSlats slats`)
		if spot then
			t.near(shape.heightM, spot.heightM, 1e-4, `{id}: the spot's height`)
		end
		t.ok(shape.lengthM > 0.8 and shape.lengthM < 1.6, `{id}: a windscreen's width ({shape.lengthM} m)`)
		for i, s in shape.slats do
			local n, r = v(s.normal), v(s.right)
			t.near(n.Magnitude, 1, 1e-3, `{id} slat {i}: unit normal`)
			t.near(r.Magnitude, 1, 1e-3, `{id} slat {i}: unit right`)
			t.near(n:Dot(r), 0, 1e-3, `{id} slat {i}: right lies in the slat`)
			t.ok(n.Z < -0.1 and n.Y > 0.1, `{id} slat {i}: faces forward and up`)
			t.ok(r.X > 0.8, `{id} slat {i}: runs toward the car's right`)
			t.near(s.heightM, shape.heightM, 1e-4, `{id} slat {i}: the strip's height`)
			t.ok(s.widthM > 0 and s.widthM < 0.2, `{id} slat {i}: a narrow slat`)
			t.ok(s.centreM[3] < 0.5 and s.centreM[2] > 0.8, `{id} slat {i}: up at the front`)
			local nxt = shape.slats[i + 1]
			if nxt then
				t.ok(nxt.centreM[1] > s.centreM[1], `{id} slat {i}: left of the next`)
				-- Contiguous: along the centre line this slat's right edge runs past
				-- the next one's left edge (by 2 x stripOverlapM, more where the
				-- strip bends in the glass's plane), and both edges stay near the
				-- join.
				local a = v(s.centreM) + r * s.widthM / 2
				local b = v(nxt.centreM) - v(nxt.right) * nxt.widthM / 2
				local over = (a - b):Dot(r)
				t.ok(over >= 2 * R.stripOverlapM - 1e-3 and over < 0.06, `{id} slat {i}: overlaps the next a little ({over} m)`)
				t.ok((a - b).Magnitude < 0.06, `{id} slat {i}: meets the next ({(a - b).Magnitude} m apart)`)
				-- And at the slats' top and bottom corners, where a bend opens a
				-- wedge: each corner still lies over the neighbour.
				local r2 = v(nxt.right)
				local up1, up2 = r:Cross(n), r2:Cross(v(nxt.normal))
				for _, sgn in { -1, 1 } do
					local p1 = a + up1 * sgn * s.heightM / 2
					local p2 = b + up2 * sgn * nxt.heightM / 2
					local o1 = (p1 - v(nxt.centreM)):Dot(r2) + nxt.widthM / 2
					local o2 = (v(s.centreM) - p2):Dot(r) + s.widthM / 2
					t.ok(math.min(o1, o2) > R.stripOverlapM, `{id} slat {i}: its corners overlap the next ({math.min(o1, o2)} m)`)
				end
				-- The canvas reads from the car's right: the next slat's slice
				-- ends inside this one's by the same overlap, so the canvas runs
				-- on across the join.
				t.near(nxt.fromM + nxt.widthM - s.fromM, over, 2e-3, `{id} slat {i}: its slice meets the next's`)
			end
		end
		local first, last = shape.slats[1], shape.slats[#shape.slats]
		t.near(last.fromM, -R.stripOverlapM, 1e-3, `{id}: the canvas starts at the right-hand slat`)
		t.near(first.fromM + first.widthM, shape.lengthM + R.stripOverlapM, 1e-3, `{id}: and ends at the left-hand one`)
	end
end
